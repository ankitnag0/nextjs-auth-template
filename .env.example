# Better Auth
BETTER_AUTH_URL=http://localhost:3000

# Admin User IDs (comma-separated)
# Add user IDs here to grant admin access
# Example: ADMIN_USER_IDS=user_123,user_456
ADMIN_USER_IDS=GfkXtlIGUcL5mkg6JlaAmWnt89lb1Fbu

# Google OAuth
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google (local)
# Redirect URI: https://yourdomain.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database
DB_FILE_NAME=local.db
